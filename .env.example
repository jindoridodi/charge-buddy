# Copy to .env.local and obtain the DEVELOPMENT values from your teammate.
# Check which migrations are already applied before changing a shared database.
# Browser authentication and authenticated/public API reads:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only importer credentials. Never use a NEXT_PUBLIC_ prefix for these.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NREL_API_KEY=your-nrel-api-key
# Separate routing/geocoding services; Supabase does not provide these.
VALHALLA_URL=http://private-valhalla:8002
NOMINATIM_URL=http://private-nominatim:8080
