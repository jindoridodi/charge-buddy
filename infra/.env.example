# Bind loopback-only unless the caller is on a private VPC/VPN address.
BIND_ADDRESS=127.0.0.1

# Begin with a regional extract. For the national deployment, replace this with
# https://download.geofabrik.de/north-america/us-latest.osm.pbf after sizing the VM.
OSM_PBF_URL=https://download.geofabrik.de/north-america/us/california-latest.osm.pbf

# Pin an immutable image digest for production after staging verification.
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest
NOMINATIM_IMAGE=mediagis/nominatim:5.3
NOMINATIM_PASSWORD=replace-with-a-long-random-secret

VALHALLA_THREADS=4
NOMINATIM_THREADS=4
NOMINATIM_WORKERS=2
NOMINATIM_SHM_SIZE=2g
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_MAINTENANCE_WORK_MEM=4GB
POSTGRES_EFFECTIVE_CACHE_SIZE=8GB
